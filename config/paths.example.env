# Copy to a local, untracked file and adapt. Scripts read these as environment variables.
# Root folder in which intermediate and output folders are created/read (use a local drive, not a cloud-sync folder).
SIF_GPP_ROOT=/path/to/working/root
# Parent folder that holds raw third-party downloads (FLUXNET, SIF products, aridity, etc.). Defaults to SIF_GPP_ROOT.
SIF_GPP_DATA_ROOT=/path/to/raw/data
# Optional: Natural Earth raster basemap used by map figures (public-domain Natural Earth 1 with shaded relief).
NE_BASEMAP_TIF=/path/to/NE1_HR_LC_SR_W.tif
# Optional: sample GOME-2 NetCDF file used by a figure script.
GOME2_SAMPLE_NC=/path/to/NSIFv2.6.2.GOME-2A.20180131_all.nc
